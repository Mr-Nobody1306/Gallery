{
  "version": 3,
  "builds": [
    {
      "src": "index.php",
      "use": "@vercel/php"
    },
    {
      "src": "actions/*.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "^/(.*\\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|json|txt|html))$",
      "dest": "/$1"
    },
    {
      "src": "^/actions/(.*\\.php)$",
      "dest": "/actions/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.php"
    }
  ]
}
