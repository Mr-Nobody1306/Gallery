{
  "version": 3,
  "builds": [
    {
      "src": "api.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "^/(.*\\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|json|txt|html))$",
      "dest": "/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api.php"
    }
  ]
}
